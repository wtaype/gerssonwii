---
// src/feature/musica/MusicaPage.astro
// 🎵 Módulo de Música & Celebración VIP • CumpleWii (Gersson Collantes 2026)
// 100% Cero CSS Inline · 0ms Latencia SPA · 25 Canciones Curadas · Persistencia de Audio
import playlist from '@semillas/musica.json';
import { OPCIONES_MUSICA_ENCUESTA } from './data/cacheMusicaEncuesta.js';
import './musica.css';

const totalCanciones = playlist.length;
const totalCumple = playlist.filter(t => t.categoria === 'cumpleanos').length;
const totalAdoracion = playlist.filter(t => t.categoria === 'adoracion').length;
const totalAcustico = playlist.filter(t => t.categoria === 'acustico' || t.categoria === 'piano').length;
const totalLofi = playlist.filter(t => t.categoria === 'lofi').length;

// Serializar para consumo rápido e inmutable en el cliente
const playlistJson = JSON.stringify(playlist);
---

<div class="geco-music-container" id="gecoMusicRoot">

  <!-- ========================================================
       1. REPRODUCTOR MAESTRO (HERO PLAYER VIP)
       ======================================================== -->
  <section class="geco-music-player" aria-label="Reproductor principal de música">
    
    <!-- Póster Cinematográfico con Arte y Ecualizador -->
    <div class="geco-music-poster">
      <img
        src="/avatar-oficial.jpg"
        alt="Gersson Collantes - Celebración de Cumpleaños"
        class="geco-music-poster-img"
        id="gecoPosterImg"
        loading="eager"
      />
      <div class="geco-music-poster-overlay"></div>

      <!-- Cabecera de Estado y Ecualizador de 4 Barras -->
      <div class="geco-poster-top">
        <div class="geco-status-pill" id="gecoStatusPill">
          <span class="geco-pulse-dot" id="gecoPulseDot"></span>
          <span id="gecoStatusText">LISTO PARA ESCUCHAR</span>
        </div>
        <div class="geco-eq-bars" id="gecoEqBars" title="Ecualizador estéreo">
          <span></span><span></span><span></span><span></span>
        </div>
      </div>

      <!-- Metadatos de la Pista Superpuestos -->
      <div class="geco-poster-meta">
        <h1 class="geco-track-title" id="gecoTrackTitle">{playlist[0]?.titulo || 'Cumpleaños Cristiano'}</h1>
        <p class="geco-track-artist" id="gecoTrackArtist">
          <span id="gecoArtistName">{playlist[0]?.artista || 'Alabanza & Jubileo Especial'}</span>
          <span>•</span>
          <span id="gecoCategoryBadge">Celebración 🎂</span>
        </p>
      </div>
    </div>

    <!-- Scrubber Ergonómico Táctil & Puntero -->
    <div class="geco-scrubber-box">
      <div
        class="geco-scrubber-track-area"
        id="gecoScrubberTrackArea"
        role="slider"
        tabindex="0"
        aria-label="Barra de avance de audio"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div class="geco-scrubber-rail">
          <div class="geco-scrubber-fill" id="gecoScrubberFill"></div>
          <div class="geco-scrubber-thumb" id="gecoScrubberThumb"></div>
        </div>
      </div>
      <div class="geco-time-row">
        <span id="gecoCurrentTime">00:00</span>
        <span id="gecoTotalDuration">{playlist[0]?.duracion || '02:20'}</span>
      </div>
    </div>

    <!-- Muelle de Controles Central -->
    <div class="geco-controls-dock">
      <!-- Aleatorio -->
      <button type="button" class="geco-ctrl-btn" id="gecoBtnShuffle" title="Modo aleatorio" aria-label="Modo aleatorio">
        <i class="fa-solid fa-shuffle"></i>
      </button>

      <!-- Pista Anterior -->
      <button type="button" class="geco-ctrl-btn" id="gecoBtnPrev" title="Canción anterior" aria-label="Canción anterior">
        <i class="fa-solid fa-backward-step"></i>
      </button>

      <!-- Play / Pause Hero Principal con Aura Dorada -->
      <button type="button" class="geco-hero-play-btn" id="gecoBtnPlay" title="Reproducir / Pausar" aria-label="Reproducir o pausar">
        <i class="fa-solid fa-play" id="gecoPlayIcon"></i>
      </button>

      <!-- Siguiente Pista -->
      <button type="button" class="geco-ctrl-btn" id="gecoBtnNext" title="Siguiente canción" aria-label="Siguiente canción">
        <i class="fa-solid fa-forward-step"></i>
      </button>

      <!-- Repetir Modo con Badge (Loop Automático Activo por Defecto) -->
      <button type="button" class="geco-ctrl-btn active" id="gecoBtnRepeat" title="Loop automático activado (Lista continua) 🔁" aria-label="Loop automático continuo">
        <i class="fa-solid fa-repeat"></i>
        <span class="geco-repeat-badge" id="gecoRepeatBadge">1</span>
      </button>

      <!-- Favorita (Heart) -->
      <button type="button" class="geco-ctrl-btn geco-btn-heart" id="gecoBtnHeart" title="Guardar en favoritas" aria-label="Guardar en favoritas">
        <i class="fa-regular fa-heart" id="gecoHeartIcon"></i>
      </button>
    </div>

    <!-- Control de Volumen Ergonómico -->
    <div class="geco-volume-bar">
      <button type="button" class="geco-vol-icon-btn" id="gecoBtnMute" aria-label="Silenciar o reactivar sonido">
        <i class="fa-solid fa-volume-high" id="gecoVolIcon"></i>
      </button>
      <input
        type="range"
        class="geco-vol-slider"
        id="gecoVolSlider"
        min="0"
        max="100"
        value="85"
        aria-label="Ajustar volumen"
      />
      <span class="geco-vol-pct" id="gecoVolPct">85%</span>
    </div>

  </section>

  <!-- ========================================================
       2. BARRA DE FILTROS & BUSCADOR EN TIEMPO REAL
       ======================================================== -->
  <section class="geco-filter-toolbar" aria-label="Filtros de pistas">
    <!-- Chips Horizontales Deslizables -->
    <div class="geco-filter-chips" role="tablist">
      <button type="button" class="geco-chip-btn active" data-category="todas" role="tab" aria-selected="true">
        <i class="fa-solid fa-music"></i>
        <span>Todas</span>
        <span class="geco-chip-count">{totalCanciones}</span>
      </button>
      <button type="button" class="geco-chip-btn" data-category="cumpleanos" role="tab" aria-selected="false">
        <i class="fa-solid fa-cake-candles"></i>
        <span>Cumpleaños 🎂</span>
        <span class="geco-chip-count">{totalCumple}</span>
      </button>
      <button type="button" class="geco-chip-btn" data-category="adoracion" role="tab" aria-selected="false">
        <i class="fa-solid fa-hands-praying"></i>
        <span>Adoración 🙏</span>
        <span class="geco-chip-count">{totalAdoracion}</span>
      </button>
      <button type="button" class="geco-chip-btn" data-category="acustico" role="tab" aria-selected="false">
        <i class="fa-solid fa-guitar"></i>
        <span>Acústico & Piano 🎹</span>
        <span class="geco-chip-count">{totalAcustico}</span>
      </button>
      <button type="button" class="geco-chip-btn" data-category="lofi" role="tab" aria-selected="false">
        <i class="fa-solid fa-headphones"></i>
        <span>Lofi Beats 🎧</span>
        <span class="geco-chip-count">{totalLofi}</span>
      </button>
      <button type="button" class="geco-chip-btn" data-category="favoritas" role="tab" aria-selected="false">
        <i class="fa-solid fa-heart"></i>
        <span>Favoritas ❤️</span>
        <span class="geco-chip-count" id="gecoFavsChipCount">0</span>
      </button>
    </div>

    <!-- Buscador en Vivo -->
    <div class="geco-search-bar">
      <i class="fa-solid fa-magnifying-glass geco-search-icon"></i>
      <input
        type="search"
        id="gecoSearchInput"
        class="geco-search-input"
        placeholder="Buscar por canción, artista o género..."
        autocomplete="off"
        aria-label="Buscar canciones"
      />
      <button type="button" class="geco-search-clear" id="gecoSearchClear" aria-label="Limpiar búsqueda">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </section>

  <!-- ========================================================
       3. LISTA DE CANCIONES (25 PISTAS VIP UNIFICADAS)
       ======================================================== -->
  <section class="geco-tracklist-box" id="gecoTracksContainer" aria-label="Lista de canciones">
    {playlist.map((track, i) => {
      const idxStr = String(i + 1).padStart(2, '0');
      const isBirthday = track.categoria === 'cumpleanos';
      const tagLabel = isBirthday
        ? 'Cumpleaños'
        : track.categoria === 'adoracion'
        ? 'Adoración'
        : track.categoria === 'alegria'
        ? 'Alegría'
        : track.categoria === 'lofi'
        ? 'Lofi Chill'
        : 'Acústico';

      return (
        <div
          class="geco-track-row"
          data-id={String(track.id)}
          data-index={i}
          data-title={track.titulo.toLowerCase()}
          data-artist={track.artista.toLowerCase()}
          data-category={track.categoria}
          tabindex="0"
          role="button"
          aria-label={`Reproducir ${track.titulo} de ${track.artista}`}
        >
          <!-- Índice Numérico o Ecualizador 3-Barras -->
          <div class="geco-row-idx-box">
            <span class="geco-row-num">{idxStr}</span>
            <div class="geco-row-eq">
              <span></span><span></span><span></span>
            </div>
          </div>

          <!-- Información de la Canción -->
          <div class="geco-row-info">
            <span class="geco-row-title">{track.titulo}</span>
            <div class="geco-row-meta">
              <span>{track.artista}</span>
              <span class="geco-row-meta-dot">•</span>
              <span>{track.duracion}</span>
              <span class="geco-row-meta-dot">•</span>
              <span class:list={['geco-row-tag', `geco-tag-${track.categoria}`]}>{tagLabel}</span>
            </div>
          </div>

          <!-- Acciones Rápidas -->
          <div class="geco-row-actions">
            <button
              type="button"
              class="geco-row-btn geco-row-btn-like"
              data-action="like"
              data-id={String(track.id)}
              title="Guardar en favoritas"
              aria-label={`Guardar en favoritas ${track.titulo}`}
            >
              <i class="fa-regular fa-heart"></i>
            </button>
            <button
              type="button"
              class="geco-row-btn geco-row-btn-play"
              data-action="play"
              data-id={String(track.id)}
              title="Reproducir ahora"
              aria-label={`Reproducir ${track.titulo}`}
            >
              <i class="fa-solid fa-play"></i>
            </button>
          </div>
        </div>
      );
    })}

    <!-- Estado Vacío Cuando la Búsqueda no Arroja Resultados -->
    <div class="geco-music-empty" id="gecoMusicEmpty">
      <i class="fa-solid fa-music-slash"></i>
      <p class="geco-empty-text">No se encontraron pistas que coincidan con tu búsqueda</p>
      <button type="button" class="geco-reset-filters-btn" id="gecoResetFiltersBtn">
        Ver todas las 25 canciones
      </button>
    </div>
  </section>

  <!-- ENCUESTA FESTIVA MUSICAL (/encuestas/musica) -->
  <article class="geco-musica-survey-card" id="seccionEncuestaMusica">
    <div class="geco-survey-top-bar">
      <span class="geco-musica-survey-badge">
        <i class="fa-solid fa-compact-disc"></i> Encuesta Musical • Tu Ambiente Favorito
      </span>
      <span class="geco-live-badge" id="surveyMusicaLiveBadge" title="Sincronización en vivo con Firebase Firestore">
        <span class="geco-live-dot"></span> En vivo
      </span>
    </div>

    <h3 class="geco-musica-survey-title">¿Qué música prefieres para esta noche de gala? 🎶</h3>
    <p class="geco-musica-survey-sub">Cuéntanos qué estilo de alabanza y ritmo te inspira más para celebrar junto a Gersson:</p>

    <!-- 5 Opciones Divertidas -->
    <div class="geco-survey-options" id="listaOpcionesMusica">
      {OPCIONES_MUSICA_ENCUESTA.map((opt, idx) => (
        <button
          type="button"
          class="geco-survey-btn"
          data-index={idx}
          data-opt-id={opt.id}
          aria-label={`Opción ${opt.titulo}`}
        >
          <div class="geco-survey-progress" id={`musicaBar-${idx}`}></div>
          <div class="geco-survey-btn-content">
            <div class="geco-survey-left">
              <div class="geco-survey-icon-circle" style={`color: ${opt.color};`}>
                <i class:list={['fa-solid', opt.icono]}></i>
              </div>
              <div>
                <div class="geco-survey-text-title">{opt.titulo}</div>
                <div class="geco-survey-text-desc">{opt.descripcion}</div>
              </div>
            </div>
            <div class="geco-survey-pct" id={`musicaPct-${idx}`}>0%</div>
          </div>
        </button>
      ))}
    </div>

    <!-- Banner de Feedback Divertido -->
    <div class="geco-survey-feedback-banner" id="musicaFeedbackBanner">
      <i class="fa-solid fa-sparkles geco-heading-icon"></i>
      <span id="musicaFeedbackText"></span>
    </div>

    <!-- Pie de Encuesta Musical -->
    <div class="geco-survey-footer">
      <div class="geco-survey-total-label" id="musicaTotalLabel">
        <i class="fa-solid fa-headphones geco-heading-icon"></i>
        <span id="musicaTotalText">Cargando respuestas...</span>
      </div>

      <div class="geco-survey-actions">
        <!-- Botón de Actualizar con Cooldown -->
        <button
          type="button"
          class="geco-survey-btn-refresh"
          id="btnActualizarMusica"
          title="Actualizar votos en tiempo real"
          aria-label="Actualizar resultados de la encuesta musical"
        >
          <i class="fa-solid fa-arrows-rotate" id="iconRefreshMusica"></i>
          <span>Actualizar</span>
        </button>

        <!-- Botón de Cambiar / Revertir Elección -->
        <button
          type="button"
          class="geco-survey-btn-reset"
          id="btnCambiarMusica"
          title="Cambiar mi elección"
          aria-label="Cambiar mi preferencia musical"
        >
          <i class="fa-solid fa-rotate-left"></i>
          <span>Cambiar respuesta</span>
        </button>
      </div>
    </div>
  </article>

</div>

<!-- Datos Inmutables para el Cliente -->
<script is:inline id="gecoMusicaSeedData" type="application/json" set:html={playlistJson}></script>

<script>
  import { audioManager } from './lib/audioManager.js';
  import {
    obtenerEstadoLocalMusicaEncuesta,
    guardarVotoLocalMusicaEncuesta,
    revertirVotoLocalMusicaEncuesta,
    sincronizarDesdeFirestoreMusicaEncuesta,
    calcularPorcentajesMusicaEncuesta,
    FEEDBACK_MSGS_MUSICA,
    OPCIONES_MUSICA_ENCUESTA
  } from './data/cacheMusicaEncuesta.js';
  import { Mensaje } from '@widev/mensajes.js';
  import { wiSmart } from '@widev';

  let estadoMusicaEncuesta = obtenerEstadoLocalMusicaEncuesta();
  let desuscribirMusicaEncuesta: (() => void) | null = null;
  let enfriamientoRefreshMusica = false;

  function renderizarEncuestaMusica() {
    const { votos, usuarioEleccion, total } = estadoMusicaEncuesta;
    const porcentajes = calcularPorcentajesMusicaEncuesta(votos, total);

    const totalTextEl = document.getElementById('musicaTotalText');
    if (totalTextEl) {
      if (total === 0) {
        totalTextEl.innerHTML = `Total de votos: <strong>0 respuestas</strong> (¡Sé el primero en votar!)`;
      } else {
        totalTextEl.innerHTML = `Total de votos: <strong>${total} ${total === 1 ? 'respuesta' : 'respuestas'}</strong>`;
      }
    }

    votos.forEach((_, idx) => {
      const bar = document.getElementById(`musicaBar-${idx}`);
      const pctEl = document.getElementById(`musicaPct-${idx}`);
      const pct = porcentajes[idx] || 0;

      if (bar) bar.style.width = `${pct}%`;
      if (pctEl) pctEl.textContent = `${pct}%`;
    });

    document.querySelectorAll('#listaOpcionesMusica .geco-survey-btn').forEach((btn, idx) => {
      btn.classList.toggle('voted', usuarioEleccion === idx);
    });

    const banner = document.getElementById('musicaFeedbackBanner');
    const bannerText = document.getElementById('musicaFeedbackText');
    const btnReset = document.getElementById('btnCambiarMusica');

    if (usuarioEleccion !== null) {
      if (banner && bannerText) {
        bannerText.textContent = FEEDBACK_MSGS_MUSICA[usuarioEleccion] || '¡Gracias por votar!';
        banner.classList.add('show');
      }
      if (btnReset) btnReset.classList.add('visible');
    } else {
      if (banner) banner.classList.remove('show');
      if (btnReset) btnReset.classList.remove('visible');
    }
  }

  function setupInteraccionesMusicaEncuesta() {
    // 1. Votación en Opciones de Música
    document.querySelectorAll('#listaOpcionesMusica .geco-survey-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-index'));
        if (estadoMusicaEncuesta.usuarioEleccion === idx) return;

        const prevIdx = estadoMusicaEncuesta.usuarioEleccion;
        const prevOptId = prevIdx !== null ? OPCIONES_MUSICA_ENCUESTA[prevIdx]?.id : null;
        const opt = OPCIONES_MUSICA_ENCUESTA[idx];
        if (!opt) return;

        // Actualización optimista local
        estadoMusicaEncuesta = guardarVotoLocalMusicaEncuesta(idx);
        renderizarEncuestaMusica();

        if (typeof (window as any).lanzarConfeti === 'function') {
          (window as any).lanzarConfeti(70);
        }

        Mensaje(FEEDBACK_MSGS_MUSICA[idx] || '¡Preferencia musical registrada!', 'success');

        // Sincronización en segundo plano con Firestore
        import('./data/dataMusicaEncuesta.js')
          .then(({ votarMusicaRemoto }) => {
            votarMusicaRemoto({
              opcionId: opt.id,
              opcionAnteriorId: prevOptId
            });
          })
          .catch((err) => console.warn('[Musica Encuesta Sync] Error:', err));
      });
    });

    // 2. Botón Cambiar / Revertir Elección de Música
    document.getElementById('btnCambiarMusica')?.addEventListener('click', () => {
      if (estadoMusicaEncuesta.usuarioEleccion === null) return;

      const prevIdx = estadoMusicaEncuesta.usuarioEleccion;
      const prevOptId = prevIdx !== null ? OPCIONES_MUSICA_ENCUESTA[prevIdx]?.id : null;

      estadoMusicaEncuesta = revertirVotoLocalMusicaEncuesta();
      renderizarEncuestaMusica();
      Mensaje('Puedes elegir nuevamente tu preferencia musical.', 'info');

      if (prevOptId) {
        import('./data/dataMusicaEncuesta.js')
          .then(({ revertirMusicaRemoto }) => {
            revertirMusicaRemoto(prevOptId);
          })
          .catch((err) => console.warn('[Musica Encuesta Revert] Error:', err));
      }
    });

    // 3. Botón Manual de Actualizar con Cooldown
    const btnRefresh = document.getElementById('btnActualizarMusica');
    btnRefresh?.addEventListener('click', async () => {
      if (enfriamientoRefreshMusica) {
        Mensaje('Resultados al día. Espera un momento para refrescar.', 'info');
        return;
      }

      enfriamientoRefreshMusica = true;
      btnRefresh.classList.add('cargando');

      try {
        const { consultarMusicaEncuesta } = await import('./data/dataMusicaEncuesta.js');
        const datosRemotos = await consultarMusicaEncuesta();
        if (datosRemotos) {
          estadoMusicaEncuesta = sincronizarDesdeFirestoreMusicaEncuesta(datosRemotos);
          renderizarEncuestaMusica();
          Mensaje('Resultados musicales actualizados en vivo 🎶', 'success');
        }
      } catch {
        Mensaje('Resultados sincronizados localmente.', 'info');
      } finally {
        setTimeout(() => btnRefresh.classList.remove('cargando'), 400);
        setTimeout(() => { enfriamientoRefreshMusica = false; }, 3500);
      }
    });
  }

  function conectarTiempoRealMusicaEncuesta() {
    wiSmart({
      js: [
        async () => {
          try {
            const { escucharMusicaEncuesta } = await import('./data/dataMusicaEncuesta.js');
            if (desuscribirMusicaEncuesta) desuscribirMusicaEncuesta();

            desuscribirMusicaEncuesta = escucharMusicaEncuesta((datosRemotos) => {
              if (datosRemotos) {
                estadoMusicaEncuesta = sincronizarDesdeFirestoreMusicaEncuesta(datosRemotos);
                renderizarEncuestaMusica();
              }
            });
          } catch (e) {
            console.warn('[wiSmart Musica Encuesta] Listener no disponible:', e);
          }
        }
      ]
    });
  }

  function initMusicaPage() {
    const root = document.getElementById('gecoMusicRoot');
    if (!root) return;

    const rawData = document.getElementById('gecoMusicaSeedData')?.textContent;
    let playlist = [];
    try {
      playlist = rawData ? JSON.parse(rawData) : [];
    } catch (e) {
      playlist = [];
    }
    if (!playlist.length) return;

    // Referencias DOM Principales
    const gecoPosterImg = document.getElementById('gecoPosterImg') as HTMLImageElement | null;
    const gecoStatusPill = document.getElementById('gecoStatusPill');
    const gecoStatusText = document.getElementById('gecoStatusText');
    const gecoPulseDot = document.getElementById('gecoPulseDot');
    const gecoEqBars = document.getElementById('gecoEqBars');
    const gecoTrackTitle = document.getElementById('gecoTrackTitle');
    const gecoArtistName = document.getElementById('gecoArtistName');
    const gecoCategoryBadge = document.getElementById('gecoCategoryBadge');

    const gecoScrubberTrackArea = document.getElementById('gecoScrubberTrackArea');
    const gecoScrubberFill = document.getElementById('gecoScrubberFill');
    const gecoScrubberThumb = document.getElementById('gecoScrubberThumb');
    const gecoCurrentTime = document.getElementById('gecoCurrentTime');
    const gecoTotalDuration = document.getElementById('gecoTotalDuration');

    const gecoBtnShuffle = document.getElementById('gecoBtnShuffle');
    const gecoBtnPrev = document.getElementById('gecoBtnPrev');
    const gecoBtnPlay = document.getElementById('gecoBtnPlay');
    const gecoPlayIcon = document.getElementById('gecoPlayIcon');
    const gecoBtnNext = document.getElementById('gecoBtnNext');
    const gecoBtnRepeat = document.getElementById('gecoBtnRepeat');
    const gecoRepeatBadge = document.getElementById('gecoRepeatBadge');
    const gecoBtnHeart = document.getElementById('gecoBtnHeart');
    const gecoHeartIcon = document.getElementById('gecoHeartIcon');

    const gecoBtnMute = document.getElementById('gecoBtnMute');
    const gecoVolIcon = document.getElementById('gecoVolIcon');
    const gecoVolSlider = document.getElementById('gecoVolSlider') as HTMLInputElement | null;
    const gecoVolPct = document.getElementById('gecoVolPct');

    const gecoSearchInput = document.getElementById('gecoSearchInput') as HTMLInputElement | null;
    const gecoSearchClear = document.getElementById('gecoSearchClear');
    const gecoTracksContainer = document.getElementById('gecoTracksContainer');
    const gecoMusicEmpty = document.getElementById('gecoMusicEmpty');
    const gecoResetFiltersBtn = document.getElementById('gecoResetFiltersBtn');
    const gecoFavsChipCount = document.getElementById('gecoFavsChipCount');

    const filterChips = root.querySelectorAll('.geco-chip-btn');
    const trackRows = root.querySelectorAll('.geco-track-row');

    let activeCategory = 'todas';
    let searchQuery = '';
    let isScrubbing = false;

    function formatTime(sec: number) {
      if (!sec || isNaN(sec) || sec < 0) return '00:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function renderScrubber(pct: number, curSec?: number) {
      const clamped = Math.max(0, Math.min(100, pct));
      if (gecoScrubberFill) gecoScrubberFill.style.width = `${clamped}%`;
      if (gecoScrubberThumb) gecoScrubberThumb.style.left = `${clamped}%`;
      if (gecoScrubberTrackArea) gecoScrubberTrackArea.setAttribute('aria-valuenow', String(Math.round(clamped)));
      if (curSec !== undefined && gecoCurrentTime) {
        gecoCurrentTime.textContent = formatTime(curSec);
      }
    }

    function syncStateUI(state: any) {
      if (!state || !state.pista) return;
      const { pista, isPlaying, isShuffle, repeatMode, volume, isCurrentFavorite, totalFavorites } = state;

      // Metadatos de la Pista
      if (gecoTrackTitle) gecoTrackTitle.textContent = pista.titulo;
      if (gecoArtistName) gecoArtistName.textContent = pista.artista;
      if (gecoTotalDuration) gecoTotalDuration.textContent = pista.duracion;

      if (gecoCategoryBadge) {
        gecoCategoryBadge.textContent = pista.categoria === 'cumpleanos'
          ? 'Celebración 🎂'
          : pista.categoria === 'adoracion'
          ? 'Adoración 🙏'
          : pista.categoria === 'alegria'
          ? 'Alegría 🎉'
          : pista.categoria === 'lofi'
          ? 'Lofi Chill 🎧'
          : 'Acústico 🎸';
      }

      // Poster dinámico (avatar de cumpleañero para canciones de cumple o Dios es Amor para alabanza)
      if (gecoPosterImg) {
        const targetSrc = pista.categoria === 'cumpleanos' ? '/avatar-oficial.jpg' : '/diosesamor.png';
        if (!gecoPosterImg.src.endsWith(targetSrc)) {
          gecoPosterImg.src = targetSrc;
        }
      }

      // Estado Play / Pausa
      if (isPlaying) {
        if (gecoStatusText) gecoStatusText.textContent = 'REPRODUCIENDO AHORA';
        gecoPulseDot?.classList.add('playing');
        gecoEqBars?.classList.add('playing');
        gecoBtnPlay?.classList.add('playing');
        if (gecoPlayIcon) {
          gecoPlayIcon.classList.remove('fa-play');
          gecoPlayIcon.classList.add('fa-pause');
        }
      } else {
        if (gecoStatusText) gecoStatusText.textContent = 'PAUSADO';
        gecoPulseDot?.classList.remove('playing');
        gecoEqBars?.classList.remove('playing');
        gecoBtnPlay?.classList.remove('playing');
        if (gecoPlayIcon) {
          gecoPlayIcon.classList.remove('fa-pause');
          gecoPlayIcon.classList.add('fa-play');
        }
      }

      // Shuffle
      gecoBtnShuffle?.classList.toggle('active', Boolean(isShuffle));

      // Repeat Mode
      gecoBtnRepeat?.classList.toggle('active', repeatMode !== 'off');
      if (gecoRepeatBadge) {
        gecoRepeatBadge.classList.toggle('visible', repeatMode === 'one');
      }

      // Heart / Favorite
      gecoBtnHeart?.classList.toggle('favorited', Boolean(isCurrentFavorite));
      if (gecoHeartIcon) {
        gecoHeartIcon.className = isCurrentFavorite ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
      }

      // Contador de favoritas
      if (gecoFavsChipCount) {
        gecoFavsChipCount.textContent = String(totalFavorites || 0);
      }

      // Volumen
      const volPct = Math.round(volume * 100);
      if (gecoVolSlider) gecoVolSlider.value = String(volPct);
      if (gecoVolPct) gecoVolPct.textContent = `${volPct}%`;
      if (gecoVolIcon) {
        gecoVolIcon.className = volPct === 0
          ? 'fa-solid fa-volume-xmark'
          : volPct < 50
          ? 'fa-solid fa-volume-low'
          : 'fa-solid fa-volume-high';
      }

      // Actualizar filas activas en el tracklist
      trackRows.forEach((row: any) => {
        const rowId = row.dataset.id;
        const isCurrent = String(rowId) === String(pista.id);
        row.classList.toggle('playing', isCurrent && isPlaying);

        const playBtn = row.querySelector('.geco-row-btn-play i');
        if (playBtn) {
          playBtn.className = (isCurrent && isPlaying) ? 'fa-solid fa-pause' : 'fa-solid fa-play';
        }

        const likeBtn = row.querySelector('.geco-row-btn-like');
        const likeIcon = row.querySelector('.geco-row-btn-like i');
        const isFav = audioManager.esFavorito(rowId);
        likeBtn?.classList.toggle('favorited', isFav);
        if (likeIcon) {
          likeIcon.className = isFav ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
        }
      });
    }

    // Suscribir al audioManager (recibe init y actualizaciones en tiempo real)
    const desuscribir = audioManager.suscribir((evento: string, datos: any, estado: any) => {
      if (evento === 'timeUpdate' && !isScrubbing) {
        renderScrubber(datos.progressPct || 0, datos.currentTime);
      } else if (evento !== 'timeUpdate') {
        syncStateUI(estado);
      }
    });

    // Control de Controles Hero
    gecoBtnPlay?.addEventListener('click', () => audioManager.togglePlay());
    gecoBtnPrev?.addEventListener('click', () => audioManager.anterior());
    gecoBtnNext?.addEventListener('click', () => audioManager.siguiente());
    gecoBtnShuffle?.addEventListener('click', () => audioManager.toggleShuffle());
    gecoBtnRepeat?.addEventListener('click', () => audioManager.cycleRepeatMode());
    gecoBtnHeart?.addEventListener('click', () => audioManager.toggleFavorito());

    // Control de Volumen
    gecoVolSlider?.addEventListener('input', (e: any) => {
      audioManager.setVolume(Number(e.target.value) / 100);
    });

    gecoBtnMute?.addEventListener('click', () => {
      const curVol = audioManager.getEstado().volume;
      audioManager.setVolume(curVol > 0 ? 0 : 0.85);
    });

    // Scrubber Táctil / Puntero
    function getScrubberFraction(e: PointerEvent) {
      if (!gecoScrubberTrackArea) return 0;
      const rect = gecoScrubberTrackArea.getBoundingClientRect();
      const clientX = e.clientX;
      const pos = Math.max(0, Math.min(rect.width, clientX - rect.left));
      return pos / rect.width;
    }

    if (gecoScrubberTrackArea) {
      gecoScrubberTrackArea.addEventListener('pointerdown', (e: PointerEvent) => {
        isScrubbing = true;
        gecoScrubberTrackArea.classList.add('scrubbing');
        gecoScrubberTrackArea.setPointerCapture(e.pointerId);

        const frac = getScrubberFraction(e);
        const dur = audioManager.getEstado().duration || 140;
        renderScrubber(frac * 100, frac * dur);
      });

      gecoScrubberTrackArea.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isScrubbing) return;
        const frac = getScrubberFraction(e);
        const dur = audioManager.getEstado().duration || 140;
        renderScrubber(frac * 100, frac * dur);
      });

      const finalizarScrub = (e: PointerEvent) => {
        if (!isScrubbing) return;
        isScrubbing = false;
        gecoScrubberTrackArea.classList.remove('scrubbing');
        try {
          gecoScrubberTrackArea.releasePointerCapture(e.pointerId);
        } catch (err) {}

        const frac = getScrubberFraction(e);
        const dur = audioManager.getEstado().duration || 140;
        audioManager.seek(frac * dur);
      };

      gecoScrubberTrackArea.addEventListener('pointerup', finalizarScrub);
      gecoScrubberTrackArea.addEventListener('pointercancel', finalizarScrub);
    }

    // Filtrado de Pistas (Categorías y Buscador)
    function aplicarFiltros() {
      let matches = 0;
      const query = searchQuery.trim().toLowerCase();

      trackRows.forEach((row: any) => {
        const id = row.dataset.id;
        const title = row.dataset.title;
        const artist = row.dataset.artist;
        const cat = row.dataset.category;
        const isFav = audioManager.esFavorito(id);

        let pasaCategoria = false;
        if (activeCategory === 'todas') {
          pasaCategoria = true;
        } else if (activeCategory === 'favoritas') {
          pasaCategoria = isFav;
        } else if (activeCategory === 'acustico') {
          pasaCategoria = (cat === 'acustico' || cat === 'piano');
        } else {
          pasaCategoria = (cat === activeCategory);
        }

        let pasaBusqueda = true;
        if (query) {
          pasaBusqueda = title.includes(query) || artist.includes(query) || cat.includes(query);
        }

        const visible = pasaCategoria && pasaBusqueda;
        row.style.display = visible ? 'flex' : 'none';
        if (visible) matches++;
      });

      if (gecoMusicEmpty) {
        gecoMusicEmpty.classList.toggle('visible', matches === 0);
      }
    }

    // Chips de Categoría
    filterChips.forEach((chip: any) => {
      chip.addEventListener('click', () => {
        filterChips.forEach((c: any) => {
          c.classList.remove('active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('active');
        chip.setAttribute('aria-selected', 'true');
        activeCategory = chip.dataset.category || 'todas';
        aplicarFiltros();
      });
    });

    // Buscador
    gecoSearchInput?.addEventListener('input', (e: any) => {
      searchQuery = e.target.value;
      gecoSearchClear?.classList.toggle('visible', Boolean(searchQuery));
      aplicarFiltros();
    });

    gecoSearchClear?.addEventListener('click', () => {
      if (gecoSearchInput) gecoSearchInput.value = '';
      searchQuery = '';
      gecoSearchClear.classList.remove('visible');
      aplicarFiltros();
    });

    gecoResetFiltersBtn?.addEventListener('click', () => {
      if (gecoSearchInput) gecoSearchInput.value = '';
      searchQuery = '';
      gecoSearchClear?.classList.remove('visible');
      activeCategory = 'todas';
      filterChips.forEach((c: any) => {
        c.classList.toggle('active', c.dataset.category === 'todas');
      });
      aplicarFiltros();
    });

    // Interacción con Filas del Tracklist
    gecoTracksContainer?.addEventListener('click', (e: any) => {
      const btnLike = e.target.closest('[data-action="like"]');
      if (btnLike) {
        e.stopPropagation();
        const id = btnLike.dataset.id;
        audioManager.toggleFavorito(id);
        return;
      }

      const row = e.target.closest('.geco-track-row');
      if (row) {
        const idx = Number(row.dataset.index);
        const currentState = audioManager.getEstado();
        if (currentState.indice === idx) {
          audioManager.togglePlay();
        } else {
          audioManager.cargarPista(idx, true);
        }
      }
    });

    // Atajos de Teclado
    const onKeydown = (e: KeyboardEvent) => {
      if (document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA') return;
      if (e.code === 'Space') {
        e.preventDefault();
        audioManager.togglePlay();
      } else if (e.code === 'ArrowRight') {
        e.preventDefault();
        const cur = audioManager.getEstado().currentTime || 0;
        audioManager.seek(cur + 5);
      } else if (e.code === 'ArrowLeft') {
        e.preventDefault();
        const cur = audioManager.getEstado().currentTime || 0;
        audioManager.seek(Math.max(0, cur - 5));
      }
    };
    window.addEventListener('keydown', onKeydown);

    // Inicializar encuesta musical festiva
    estadoMusicaEncuesta = obtenerEstadoLocalMusicaEncuesta();
    renderizarEncuestaMusica();
    setupInteraccionesMusicaEncuesta();
    conectarTiempoRealMusicaEncuesta();

    // Limpieza al cambiar de página en Astro ClientRouter
    document.addEventListener('astro:before-swap', () => {
      desuscribir();
      if (desuscribirMusicaEncuesta) desuscribirMusicaEncuesta();
      window.removeEventListener('keydown', onKeydown);
    }, { once: true });
  }

  // Inicializar en carga directa o navegación SPA
  document.addEventListener('astro:page-load', initMusicaPage);
</script>
