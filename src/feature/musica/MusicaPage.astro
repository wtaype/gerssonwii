---
// src/feature/musica/MusicaPage.astro
// 🎵 Módulo Oficial de Música & Concentración Offline para Clayda · BecaWii 2026
// - Póster cinematográfico con metadatos integrados sobre la imagen
// - Scrubber de tiempo cómodo, alto y táctil con Pointer Events y seeking en vivo
// - Barra horizontal en una sola línea (Todos, Favoritos, Buscador)
// - Lista de canciones en contenedor unificado de var(--surface) con dividers sutiles
// - 100% tokens de witema.css y unidades vh/vw

import playlistData from '../../semillas/playlist.json' with { type: 'json' };
import './musica.css';

const playlistJson = JSON.stringify(playlistData);
const totalCanciones = playlistData.length;
---

<div class="musica-container appwii" id="musicaRoot">

  <!-- ========================================================
       1. REPRODUCTOR MAESTRO (POSTER CINEMÁTICO + CONTROLES)
       ======================================================== -->
  <section class="musica-player-card" aria-label="Reproductor principal de música">
    
    <!-- Póster Panorámico con Título Superpuesto -->
    <div class="musica-poster-box">
      <img 
        src="/diosesamor.png" 
        alt="Arte de portada - Santuario de Paz" 
        class="musica-poster-img"
        id="musicaPosterImg"
      />
      <div class="musica-poster-gradient"></div>

      <!-- Cabecera de estado superior -->
      <div class="musica-poster-head">
        <div class="musica-status-pill" id="musicaStatusPill">
          <span class="musica-pulse-dot" id="musicaPulseDot"></span>
          <span id="musicaStatusText">REPRODUCIENDO AHORA</span>
        </div>
        <!-- Ecualizador miniatura en póster -->
        <div class="musica-header-eq" id="musicaHeaderEq">
          <span></span><span></span><span></span><span></span>
        </div>
      </div>

      <!-- Metadatos de la canción sobre el póster -->
      <div class="musica-poster-info">
        <h1 class="musica-track-title" id="musicaTrackTitle">Océanos (Donde mis pies pueden fallar)</h1>
        <p class="musica-track-artist" id="musicaTrackArtist">Evan Craft &amp; Carley Redpath • Hillsong</p>
      </div>
    </div>

    <!-- Barra de Progreso Cómoda, Táctil y Alta (Scrubber) -->
    <div class="musica-scrubber-section">
      <div 
        class="musica-scrubber-hitbox" 
        id="musicaScrubberBar" 
        role="slider" 
        tabindex="0"
        aria-label="Barra de progreso de canción"
        aria-valuemin="0" 
        aria-valuemax="100" 
        aria-valuenow="0"
      >
        <div class="musica-scrubber-track">
          <div class="musica-scrubber-fill" id="musicaScrubberFill"></div>
          <div class="musica-scrubber-thumb" id="musicaScrubberThumb"></div>
        </div>
      </div>
      <div class="musica-time-row">
        <span class="musica-time-text" id="musicaCurrentTime">00:00</span>
        <span class="musica-time-text" id="musicaTotalDuration">07:08</span>
      </div>
    </div>

    <!-- Muelle de Controles Unificado (Like al costado de Loop) -->
    <div class="musica-controls-dock">
      <!-- Aleatorio -->
      <button type="button" class="musica-btn-round" id="musicaBtnShuffle" title="Modo aleatorio" aria-label="Modo aleatorio">
        <i class="fa-solid fa-shuffle"></i>
      </button>

      <!-- Canción Anterior -->
      <button type="button" class="musica-btn-round" id="musicaBtnPrev" title="Canción anterior" aria-label="Canción anterior">
        <i class="fa-solid fa-backward-step"></i>
      </button>

      <!-- Hero Play / Pausa -->
      <button type="button" class="musica-hero-play" id="musicaBtnPlay" title="Reproducir / Pausar" aria-label="Reproducir o pausar">
        <i class="fa-solid fa-play" id="musicaPlayIcon"></i>
      </button>

      <!-- Siguiente Canción -->
      <button type="button" class="musica-btn-round" id="musicaBtnNext" title="Siguiente canción" aria-label="Siguiente canción">
        <i class="fa-solid fa-forward-step"></i>
      </button>

      <!-- Repetir (Loop) -->
      <button type="button" class="musica-btn-round" id="musicaBtnRepeat" title="Repetir canción" aria-label="Repetir canción">
        <i class="fa-solid fa-repeat"></i>
        <span class="musica-repeat-badge" id="musicaRepeatBadge">1</span>
      </button>

      <!-- Botón de Like directo al lado de Loop -->
      <button type="button" class="musica-btn-round musica-btn-like" id="musicaBtnHeart" title="Me gusta / Favorita" aria-label="Marcar como favorita">
        <i class="fa-regular fa-heart" id="musicaHeartIcon"></i>
      </button>
    </div>

    <!-- Control de Volumen Compacto -->
    <div class="musica-volume-row">
      <button type="button" class="musica-mute-btn" id="musicaBtnMute" aria-label="Silenciar">
        <i class="fa-solid fa-volume-high" id="musicaVolIcon"></i>
      </button>
      <input 
        type="range" 
        class="musica-volume-slider" 
        id="musicaVolSlider" 
        min="0" 
        max="100" 
        value="85" 
        aria-label="Volumen de audio"
      />
      <span class="musica-volume-text" id="musicaVolText">85%</span>
    </div>

  </section>

  <!-- ========================================================
       2. BARRA DE HERRAMIENTAS EN UNA SOLA LÍNEA (TODOS, FAVORITOS, BUSCADOR)
       ======================================================== -->
  <section class="musica-single-toolbar" aria-label="Filtros y Búsqueda">
    <!-- Botón Todos -->
    <button type="button" class="musica-nav-pill active" id="musicaTabTodas" title="Ver todas las canciones">
      <i class="fa-solid fa-music"></i>
      <span class="musica-pill-text">Todos</span>
      <span class="musica-pill-badge" id="musicaCountTodas">{totalCanciones}</span>
    </button>

    <!-- Botón Favoritos separado y nativo -->
    <button type="button" class="musica-nav-pill" id="musicaTabFavoritas" title="Ver canciones favoritas">
      <i class="fa-solid fa-heart"></i>
      <span class="musica-pill-text">Favoritos</span>
      <span class="musica-pill-badge" id="musicaCountFavs">0</span>
    </button>

    <!-- Buscador integrado ocupando el resto de la misma línea -->
    <div class="musica-inline-search">
      <i class="fa-solid fa-magnifying-glass musica-inline-search-icon"></i>
      <input 
        type="text" 
        id="musicaSearchInput" 
        class="musica-inline-search-input" 
        placeholder="Buscar..." 
        autocomplete="off"
        aria-label="Buscar canción por título o artista"
      />
      <button type="button" class="musica-inline-clear-btn" id="musicaSearchClear" aria-label="Limpiar búsqueda">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </section>

  <!-- ========================================================
       3. LISTA DE CANCIONES (EN CONTENEDOR UNIFICADO)
       ======================================================== -->
  <section class="musica-playlist-wrapper" aria-label="Lista de canciones">
    <div class="musica-tracks-box" id="musicaTracksContainer">
      {playlistData.map((track, i) => {
        const idxStr = String(i + 1).padStart(2, '0');
        const trackId = track.id || `track-${i + 1}`;
        const trackTitle = track.titulo || `Pista ${i + 1}`;
        const trackArtist = track.artista || 'BecaWii 2026';
        const trackDur = track.duracion || '--:--';
        const trackPeso = track.peso || '';
        return (
          <div 
            class={`musica-song-card ${i === 0 ? 'playing' : ''}`} 
            data-id={trackId} 
            data-title={trackTitle.toLowerCase()} 
            data-artist={trackArtist.toLowerCase()}
            data-index={i}
            data-duration={trackDur}
            tabindex="0"
            role="button"
            aria-label={`Reproducir ${trackTitle} de ${trackArtist}`}
          >
            <!-- Indicador numérico o ecualizador saltarín -->
            <div class="musica-song-idx-box">
              <span class="musica-song-num">{idxStr}</span>
              <div class="musica-song-eq">
                <span></span><span></span><span></span>
              </div>
            </div>

            <!-- Título y datos de la pista -->
            <div class="musica-song-details">
              <span class="musica-song-title">{trackTitle}</span>
              <div class="musica-song-meta-row">
                <span class="musica-song-artist">{trackArtist}</span>
                {trackDur && trackDur !== '--:--' && (
                  <>
                    <span class="musica-meta-dot">•</span>
                    <span class="musica-meta-val">{trackDur}</span>
                  </>
                )}
                {trackPeso && (
                  <>
                    <span class="musica-meta-dot">•</span>
                    <span class="musica-meta-val">{trackPeso}</span>
                  </>
                )}
              </div>
            </div>

            <!-- Acciones: Like y Play -->
            <div class="musica-song-actions">
              <button 
                type="button" 
                class="musica-song-btn-like" 
                data-action="like" 
                data-id={trackId} 
                title="Marcar favorita"
                aria-label={`Marcar favorita ${trackTitle}`}
              >
                <i class="fa-regular fa-heart"></i>
              </button>
              <button 
                type="button" 
                class="musica-song-btn-play" 
                data-action="play" 
                data-id={trackId} 
                title="Reproducir"
                aria-label={`Reproducir ${trackTitle}`}
              >
                <i class="fa-solid fa-play"></i>
              </button>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Estado vacío si la búsqueda no encuentra canciones -->
    <div class="musica-empty-state" id="musicaEmptyState" style="display: none;">
      <i class="fa-solid fa-music-slash"></i>
      <p class="musica-empty-text">No se encontraron canciones</p>
      <button type="button" class="musica-btn-reset-search" id="musicaBtnResetFilters">Ver todas las canciones</button>
    </div>
  </section>

</div>

<!-- DATOS DE LA LISTA EN JSON PARA CONSUMO INICIAL -->
<script is:inline id="musicaPlaylistJsonData" type="application/json" set:html={playlistJson}></script>

<script>
  import { audioManager } from './lib/audioManager.js';

  function initMusicaFeature() {
    const musicaRoot = document.getElementById('musicaRoot');
    if (!musicaRoot) return;
    if (musicaRoot.dataset.initialized === 'true') return;
    musicaRoot.dataset.initialized = 'true';

    const rawData = document.getElementById('musicaPlaylistJsonData')?.textContent;
    let playlist = [];
    try {
      playlist = rawData ? JSON.parse(rawData) : [];
    } catch (e) {
      playlist = [];
    }
    if (!playlist.length) return;

    let filterMode = 'todas'; // 'todas' | 'favoritas'
    let searchQuery = '';
    let isDraggingScrubber = false;

    // Referencias DOM
    const musicaTrackTitle = document.getElementById('musicaTrackTitle');
    const musicaTrackArtist = document.getElementById('musicaTrackArtist');
    const musicaStatusText = document.getElementById('musicaStatusText');
    const musicaHeaderEq = document.getElementById('musicaHeaderEq');

    const musicaScrubberBar = document.getElementById('musicaScrubberBar');
    const musicaScrubberFill = document.getElementById('musicaScrubberFill');
    const musicaScrubberThumb = document.getElementById('musicaScrubberThumb');
    const musicaCurrentTime = document.getElementById('musicaCurrentTime');
    const musicaTotalDuration = document.getElementById('musicaTotalDuration');

    const musicaBtnPlay = document.getElementById('musicaBtnPlay');
    const musicaPlayIcon = document.getElementById('musicaPlayIcon');
    const musicaBtnPrev = document.getElementById('musicaBtnPrev');
    const musicaBtnNext = document.getElementById('musicaBtnNext');
    const musicaBtnShuffle = document.getElementById('musicaBtnShuffle');
    const musicaBtnRepeat = document.getElementById('musicaBtnRepeat');
    const musicaRepeatBadge = document.getElementById('musicaRepeatBadge');
    const musicaBtnHeart = document.getElementById('musicaBtnHeart');
    const musicaHeartIcon = document.getElementById('musicaHeartIcon');

    const musicaBtnMute = document.getElementById('musicaBtnMute');
    const musicaVolIcon = document.getElementById('musicaVolIcon');
    const musicaVolSlider = document.getElementById('musicaVolSlider');
    const musicaVolText = document.getElementById('musicaVolText');

    const musicaTabTodas = document.getElementById('musicaTabTodas');
    const musicaTabFavoritas = document.getElementById('musicaTabFavoritas');
    const musicaCountTodas = document.getElementById('musicaCountTodas');
    const musicaCountFavs = document.getElementById('musicaCountFavs');

    const musicaSearchInput = document.getElementById('musicaSearchInput');
    const musicaSearchClear = document.getElementById('musicaSearchClear');
    const musicaTracksContainer = document.getElementById('musicaTracksContainer');
    const musicaEmptyState = document.getElementById('musicaEmptyState');
    const musicaBtnResetFilters = document.getElementById('musicaBtnResetFilters');

    // Parsear mm:ss a segundos
    function parseDurationStr(str: string | any) {
      if (!str) return 0;
      const parts = str.split(':').map(Number);
      if (parts.length === 2) return (parts[0] * 60) + parts[1];
      if (parts.length === 3) return (parts[0] * 3600) + (parts[1] * 60) + parts[2];
      return 0;
    }

    // Formatear segundos a mm:ss
    function formatTime(sec: number | any) {
      if (!sec || isNaN(sec) || sec < 0) return '00:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    // Obtener duración confiable actual
    function getDuracionActual(track: any) {
      if (audioManager.audio && !isNaN(audioManager.audio.duration) && audioManager.audio.duration > 0) {
        return audioManager.audio.duration;
      }
      const st = audioManager.getEstado();
      if (st.duration && !isNaN(st.duration) && st.duration > 0) {
        return st.duration;
      }
      if (track && track.duracion) {
        return parseDurationStr(track.duracion);
      }
      return 0;
    }

    // Actualizar visualmente la barra del scrubber
    function updateScrubberVisual(pct: number | any, curSec: number | null | any = null) {
      const clampedPct = Math.min(100, Math.max(0, pct));
      if (musicaScrubberFill) musicaScrubberFill.style.width = `${clampedPct}%`;
      if (musicaScrubberThumb) musicaScrubberThumb.style.left = `${clampedPct}%`;
      if (musicaScrubberBar) musicaScrubberBar.setAttribute('aria-valuenow', String(Math.round(clampedPct)));
      if (curSec !== null && musicaCurrentTime) {
        musicaCurrentTime.textContent = formatTime(curSec);
      }
    }

    // Detección de parámetro en URL: ?1, ?2, ?track=1, ?id=track-1
    function obtenerIndiceDesdeUrl() {
      const search = window.location.search;
      if (!search) return null;

      // 1. Formato directo pedido por el usuario: ?1, ?2, ?10
      const matchDirecto = search.match(/^\?([0-9]+)$/);
      if (matchDirecto) {
        const num = parseInt(matchDirecto[1], 10);
        return num - 1; // 1-based (usuario) a 0-based (array)
      }

      // 2. Parámetros estándar clave=valor (?track=1, ?id=1, ?cancion=1, ?p=1)
      const params = new URLSearchParams(search);
      const paramVal = params.get('track') || params.get('id') || params.get('p') || params.get('cancion') || params.get('song');
      if (paramVal) {
        if (/^[0-9]+$/.test(paramVal)) {
          return parseInt(paramVal, 10) - 1;
        }
        const idxPorId = playlist.findIndex((t: any) => t.id === paramVal);
        if (idxPorId !== -1) return idxPorId;
      }

      // 3. Clave suelta sin valor (?1= o ?2)
      for (const key of params.keys()) {
        if (/^[0-9]+$/.test(key)) {
          return parseInt(key, 10) - 1;
        }
        const idxPorId = playlist.findIndex((t: any) => t.id === key);
        if (idxPorId !== -1) return idxPorId;
      }

      return null;
    }

    // Sincronizar URL de forma limpia y transparente sin recargar
    function actualizarUrlConPista(index: number) {
      if (index < 0 || index >= playlist.length) return;
      const numPista = index + 1;
      const targetQuery = `?${numPista}`;
      if (window.location.search !== targetQuery) {
        window.history.replaceState({ track: numPista }, '', `${window.location.pathname}${targetQuery}`);
      }
    }

    // Sincronizar UI del reproductor y filas
    function syncPlayerUI(estado?: any) {
      if (!estado) estado = audioManager.getEstado();
      const track = estado.pista || (audioManager.playlist ? audioManager.playlist[audioManager.currentIndex] : null);

      if (track) {
        if (musicaTrackTitle) musicaTrackTitle.textContent = track.titulo;
        if (musicaTrackArtist) musicaTrackArtist.textContent = track.artista;
        if (musicaTotalDuration) musicaTotalDuration.textContent = track.duracion || '--:--';
      }

      // Estado Play / Pausa
      if (musicaPlayIcon) {
        musicaPlayIcon.className = estado.isPlaying ? 'fa-solid fa-pause' : 'fa-solid fa-play';
      }
      if (musicaStatusText) {
        musicaStatusText.textContent = estado.isPlaying ? 'REPRODUCIENDO AHORA' : 'EN PAUSA';
      }
      if (musicaHeaderEq) {
        musicaHeaderEq.className = estado.isPlaying ? 'musica-header-eq playing' : 'musica-header-eq';
      }

      // Shuffle & Repeat
      if (musicaBtnShuffle) {
        musicaBtnShuffle.classList.toggle('active', !!estado.isShuffle);
      }
      if (musicaBtnRepeat) {
        musicaBtnRepeat.classList.toggle('active', estado.repeatMode !== 'off');
        if (musicaRepeatBadge) {
          musicaRepeatBadge.className = estado.repeatMode === 'one' ? 'musica-repeat-badge visible' : 'musica-repeat-badge';
        }
      }

      // Botón Like en controles
      const isFav = track ? audioManager.esFavorito(track.id) : false;
      if (musicaBtnHeart && musicaHeartIcon) {
        musicaBtnHeart.classList.toggle('active', isFav);
        musicaHeartIcon.className = isFav ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
      }

      // Conteos de toolbar
      if (musicaCountFavs) {
        musicaCountFavs.textContent = String(audioManager.favorites.size || 0);
      }
      if (musicaCountTodas) {
        musicaCountTodas.textContent = String(playlist.length);
      }

      // Progreso inicial si no estamos arrastrando
      if (!isDraggingScrubber) {
        const cur = audioManager.audio ? audioManager.audio.currentTime : (estado.currentTime || 0);
        const dur = getDuracionActual(track);
        if (dur > 0) {
          const pct = (cur / dur) * 100;
          updateScrubberVisual(pct, cur);
          if (musicaTotalDuration) musicaTotalDuration.textContent = formatTime(dur);
        }
      }

      // Sincronizar tarjetas de canciones
      document.querySelectorAll('.musica-song-card').forEach((card: any) => {
        const id = card.getAttribute('data-id');
        const isCurrent = track && track.id === id;
        card.classList.toggle('playing', isCurrent);

        const playBtnIcon = card.querySelector('.musica-song-btn-play i');
        if (playBtnIcon) {
          playBtnIcon.className = isCurrent && estado.isPlaying ? 'fa-solid fa-pause' : 'fa-solid fa-play';
        }

        const likeBtn = card.querySelector('.musica-song-btn-like');
        const likeIcon = card.querySelector('.musica-song-btn-like i');
        const itemIsFav = audioManager.esFavorito(id);
        if (likeBtn && likeIcon) {
          likeBtn.classList.toggle('active', itemIsFav);
          likeIcon.className = itemIsFav ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
        }
      });
    }

    // Filtrar canciones en la lista
    function filterCards() {
      let visibleCount = 0;
      const q = searchQuery.toLowerCase().trim();

      document.querySelectorAll('.musica-song-card').forEach((card: any) => {
        const id = card.getAttribute('data-id');
        const title = card.getAttribute('data-title') || '';
        const artist = card.getAttribute('data-artist') || '';

        let matchesTab = true;
        if (filterMode === 'favoritas') {
          matchesTab = audioManager.esFavorito(id);
        }

        let matchesSearch = true;
        if (q) {
          matchesSearch = title.includes(q) || artist.includes(q);
        }

        if (matchesTab && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (musicaTracksContainer) {
        musicaTracksContainer.style.display = visibleCount === 0 ? 'none' : 'flex';
      }
      if (musicaEmptyState) {
        musicaEmptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
      }
      if (musicaCountTodas) musicaCountTodas.textContent = String(playlist.length);
      if (musicaCountFavs) musicaCountFavs.textContent = String(audioManager.favorites.size || 0);
    }

    // ========================================================
    // CONTROL DEL SCRUBBER CON POINTER EVENTS DE ALTA PRECISIÓN
    // ========================================================
    function calculateSeekPosition(e: any) {
      if (!musicaScrubberBar) return 0;
      const rect = musicaScrubberBar.getBoundingClientRect();
      const clientX = e.clientX;
      const pos = (clientX - rect.left) / rect.width;
      return Math.max(0, Math.min(1, pos));
    }

    if (musicaScrubberBar) {
      musicaScrubberBar.addEventListener('pointerdown', (e: PointerEvent) => {
        isDraggingScrubber = true;
        try {
          musicaScrubberBar.setPointerCapture(e.pointerId);
        } catch (_) {}

        const pos = calculateSeekPosition(e);
        const track = audioManager.getPistaActual();
        const dur = getDuracionActual(track);
        const targetSec = pos * dur;

        updateScrubberVisual(pos * 100, targetSec);
      });

      musicaScrubberBar.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDraggingScrubber) return;
        const pos = calculateSeekPosition(e);
        const track = audioManager.getPistaActual();
        const dur = getDuracionActual(track);
        const targetSec = pos * dur;

        updateScrubberVisual(pos * 100, targetSec);
      });

      const finishSeek = (e: any) => {
        if (!isDraggingScrubber) return;
        isDraggingScrubber = false;
        try {
          musicaScrubberBar.releasePointerCapture(e.pointerId);
        } catch (_) {}

        const pos = calculateSeekPosition(e);
        const track = audioManager.getPistaActual();
        const dur = getDuracionActual(track);
        const targetSec = pos * dur;

        if (dur > 0) {
          audioManager.seek(targetSec);
        }
      };

      musicaScrubberBar.addEventListener('pointerup', finishSeek);
      musicaScrubberBar.addEventListener('pointercancel', finishSeek);
    }

    // ========================================================
    // EVENTOS DE BOTONES
    // ========================================================

    musicaBtnPlay?.addEventListener('click', () => audioManager.togglePlay());
    musicaBtnNext?.addEventListener('click', () => audioManager.siguiente());
    musicaBtnPrev?.addEventListener('click', () => audioManager.anterior());
    musicaBtnShuffle?.addEventListener('click', () => audioManager.toggleShuffle());
    musicaBtnRepeat?.addEventListener('click', () => audioManager.cycleRepeatMode());

    musicaBtnHeart?.addEventListener('click', () => {
      audioManager.toggleFavorito();
      syncPlayerUI(audioManager.getEstado());
      filterCards();
    });

    // Control de volumen
    musicaVolSlider?.addEventListener('input', (e: Event) => {
      const target = e.target as HTMLInputElement;
      if (!target) return;
      const val = Number(target.value) / 100;
      audioManager.setVolume(val);
      if (musicaVolText) musicaVolText.textContent = `${Math.round(val * 100)}%`;
      if (musicaVolIcon) {
        musicaVolIcon.className = val === 0 ? 'fa-solid fa-volume-xmark' : val < 0.5 ? 'fa-solid fa-volume-low' : 'fa-solid fa-volume-high';
      }
    });

    let prevVolume = 0.85;
    musicaBtnMute?.addEventListener('click', () => {
      if (audioManager.volume > 0) {
        prevVolume = audioManager.volume;
        audioManager.setVolume(0);
        if (musicaVolSlider) (musicaVolSlider as HTMLInputElement).value = '0';
        if (musicaVolText) musicaVolText.textContent = '0%';
        if (musicaVolIcon) musicaVolIcon.className = 'fa-solid fa-volume-xmark';
      } else {
        const nextV = prevVolume || 0.85;
        audioManager.setVolume(nextV);
        if (musicaVolSlider) (musicaVolSlider as HTMLInputElement).value = String(Math.round(nextV * 100));
        if (musicaVolText) musicaVolText.textContent = `${Math.round(nextV * 100)}%`;
        if (musicaVolIcon) musicaVolIcon.className = 'fa-solid fa-volume-high';
      }
    });

    // Filtros de Pestaña Todos / Favoritos
    musicaTabTodas?.addEventListener('click', () => {
      filterMode = 'todas';
      musicaTabTodas.classList.add('active');
      musicaTabFavoritas?.classList.remove('active');
      filterCards();
    });

    musicaTabFavoritas?.addEventListener('click', () => {
      filterMode = 'favoritas';
      musicaTabFavoritas.classList.add('active');
      musicaTabTodas?.classList.remove('active');
      filterCards();
    });

    // Buscador
    musicaSearchInput?.addEventListener('input', (e: Event) => {
      const target = e.target as HTMLInputElement;
      if (!target) return;
      searchQuery = target.value;
      if (musicaSearchClear) {
        musicaSearchClear.classList.toggle('visible', searchQuery.length > 0);
      }
      filterCards();
    });

    musicaSearchClear?.addEventListener('click', () => {
      if (musicaSearchInput) (musicaSearchInput as HTMLInputElement).value = '';
      searchQuery = '';
      musicaSearchClear.classList.remove('visible');
      filterCards();
      musicaSearchInput?.focus();
    });

    musicaBtnResetFilters?.addEventListener('click', () => {
      filterMode = 'todas';
      searchQuery = '';
      if (musicaSearchInput) (musicaSearchInput as HTMLInputElement).value = '';
      musicaTabTodas?.classList.add('active');
      musicaTabFavoritas?.classList.remove('active');
      filterCards();
    });

    // Delegación unificada en el contenedor (¡garantiza play instantáneo al primer clic!)
    if (musicaTracksContainer) {
      musicaTracksContainer.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        if (!target) return;

        // Botón de Like
        const likeBtn = target.closest('[data-action="like"]');
        if (likeBtn) {
          e.stopPropagation();
          const id = likeBtn.getAttribute('data-id');
          audioManager.toggleFavorito(id);
          syncPlayerUI(audioManager.getEstado());
          filterCards();
          return;
        }

        // Clic en la tarjeta de canción o en su botón de play
        const card = target.closest('.musica-song-card') as HTMLElement;
        if (!card) return;

        const idx = Number(card.getAttribute('data-index'));
        if (isNaN(idx)) return;

        if (audioManager.currentIndex === idx) {
          audioManager.togglePlay();
        } else {
          audioManager.cargarPista(idx, true);
          actualizarUrlConPista(idx);
        }
      });

      // Accesibilidad con teclado: Enter o Espacio sobre tarjeta seleccionada
      musicaTracksContainer.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          const target = e.target as HTMLElement;
          if (target && target.classList.contains('musica-song-card')) {
            e.preventDefault();
            const idx = Number(target.getAttribute('data-index'));
            if (!isNaN(idx)) {
              if (audioManager.currentIndex === idx) {
                audioManager.togglePlay();
              } else {
                audioManager.cargarPista(idx, true);
                actualizarUrlConPista(idx);
              }
            }
          }
        }
      });
    }

    // Atajos de teclado web super profesionales (Espacio = Play/Pausa, Flechas = Prev/Next, M = Mute)
    const manejarAtajosTeclado = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      const isInput = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
      if (isInput) return;

      if (e.code === 'Space') {
        e.preventDefault();
        audioManager.togglePlay();
      } else if (e.code === 'ArrowRight') {
        e.preventDefault();
        audioManager.siguiente();
      } else if (e.code === 'ArrowLeft') {
        e.preventDefault();
        audioManager.anterior();
      } else if (e.key === 'm' || e.key === 'M') {
        e.preventDefault();
        musicaBtnMute?.click();
      }
    };
    window.addEventListener('keydown', manejarAtajosTeclado);

    // Navegación con historial de navegador (Atrás / Adelante)
    const manejarPopState = () => {
      const urlIdx = obtenerIndiceDesdeUrl();
      if (urlIdx !== null && urlIdx >= 0 && urlIdx < playlist.length && urlIdx !== audioManager.currentIndex) {
        audioManager.cargarPista(urlIdx, true);
      }
    };
    window.addEventListener('popstate', manejarPopState);

    // Suscripción al gestor de audio global para tiempo real
    audioManager.suscribir((evento: string, datos?: any, estado?: any) => {
      try {
        if (!estado) estado = audioManager.getEstado();
        syncPlayerUI(estado);

        // Al cambiar de pista, mantener la URL sincronizada (?1, ?2)
        if (evento === 'trackChange' && datos && typeof datos.indice === 'number') {
          actualizarUrlConPista(datos.indice);
        }

        // Notificación de tiempo de reproducción en vivo
        if ((evento === 'timeUpdate' || evento === 'metadata') && datos && !isDraggingScrubber) {
          const cur = datos.currentTime || 0;
          const dur = datos.duration || getDuracionActual(estado.pista);
          if (musicaCurrentTime) musicaCurrentTime.textContent = formatTime(cur);
          if (musicaTotalDuration && dur > 0) musicaTotalDuration.textContent = formatTime(dur);

          if (dur > 0) {
            const pct = (cur / dur) * 100;
            updateScrubberVisual(pct, cur);
          }
        }
      } catch (err) {
        console.warn('Error en listener de musica:', err);
      }
    });

    // Inicialización inmediata de filtros e interfaz
    filterCards();
    syncPlayerUI(audioManager.getEstado());

    // Cargar parámetro de URL al entrar a la página (?1, ?2, ?track=1, etc.)
    const indiceUrl = obtenerIndiceDesdeUrl();
    if (indiceUrl !== null && indiceUrl >= 0 && indiceUrl < playlist.length) {
      audioManager.cargarPista(indiceUrl, true);
      actualizarUrlConPista(indiceUrl);
    }
  }

  // En Astro con ClientRouter, escuchar astro:page-load para inicializar sin duplicaciones
  document.addEventListener('astro:page-load', initMusicaFeature);
</script>
