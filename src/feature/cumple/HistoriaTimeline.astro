---
// src/feature/cumple/HistoriaTimeline.astro
// 📖 Línea de Tiempo: "Mi Historia en 5 Pasitos de Bendición"
// Fotos Extra Grandes con Carga Progresiva imgwii (Blur-Up + /wpuntos.svg)
// 100% Cero CSS Inline - Tokens WiTema y Datos Desacoplados
import historiaSeed from '@semillas/historia.json';

const pasitos = Array.isArray(historiaSeed) ? historiaSeed : [];
---

<section class="geco-timeline-section" aria-label="Historia de Gersson en 5 Pasitos">
  <!-- Encabezado de Sección -->
  <div class="geco-section-heading">
    <h3>
      <i class="fa-solid fa-timeline geco-heading-icon"></i>
      <span>Mi Historia en 5 Pasitos de Bendición</span>
    </h3>
    <p>Cinco momentos especiales que han marcado el camino que Dios trazó para mí</p>
  </div>

  <!-- Riel Dorado Vertical Continuo -->
  <div class="geco-timeline-stream" id="timelineStream">
    {pasitos.map((pasito) => (
      <article class="geco-timeline-node" data-pasito-num={pasito.numero}>
        <!-- Bullet Circular sobre el Riel -->
        <span class="geco-timeline-bullet" aria-hidden="true"></span>

        <!-- Contenedor de Foto Extra Grande con imgwii blur-up y placeholder SVG -->
        <div class="geco-node-photo-container">
          <img
            src="/wpuntos.svg"
            data-src={pasito.foto || ''}
            alt={pasito.alt || pasito.titulo || ''}
            class="geco-node-photo wi_skeleton"
            loading="lazy"
            decoding="async"
            width="800"
            height="340"
          />
        </div>

        <!-- Cuerpo del Pasito -->
        <div class="geco-node-body">
          {pasito.tag && <span class="geco-node-tag">{pasito.tag}</span>}
          <h4 class="geco-node-title">{pasito.titulo || ''}</h4>
          <p class="geco-node-desc">{pasito.descripcion || ''}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import { imgwii } from '@widev';

  function activarImgWii() {
    imgwii.ver('#timelineStream');
  }

  activarImgWii();
  document.addEventListener('astro:page-load', activarImgWii);
</script>
