---
// src/feature/cumple/EncuestaCard.astro
// 📊 Encuesta Interactiva: "¿De dónde nos conocemos? 💕"
// 5 Opciones Oficiales en Vivo vía /encuestas/conocemos (Documento Único)
// Máximo Rendimiento y Ahorro de Cuota: wiSmart + Rate-Limit de Lecturas
// 100% Cero CSS Inline - Tokens WiTema y Datos Desacoplados
import encuestaSeed from '@semillas/encuesta.json';

const pregunta = encuestaSeed.pregunta || '¿De dónde nos conocemos? 💕';
const subtitulo = encuestaSeed.subtitulo || 'Elige tu vínculo con Gersson para saber de qué rincón viene la gente linda que me acompaña este cumpleaños:';
const opciones = Array.isArray(encuestaSeed.opciones) ? encuestaSeed.opciones : [];
---

<div class="geco-survey-card" id="seccionEncuestaV9">
  <!-- Barra Superior con Badge y Estado En Vivo -->
  <div class="geco-survey-top-bar">
    <span class="geco-survey-badge">
      <i class="fa-solid fa-square-poll-vertical"></i> Encuesta de Amigos & Vínculo
    </span>
    <span class="geco-live-badge" id="surveyLiveBadge" title="Sincronización en vivo con Firebase Firestore">
      <span class="geco-live-dot"></span> En vivo
    </span>
  </div>

  <!-- Pregunta y Subtítulo -->
  <h3 class="geco-survey-title">{pregunta}</h3>
  <p class="geco-survey-sub">{subtitulo}</p>

  <!-- 5 Opciones Oficiales de Votación -->
  <div class="geco-survey-options" id="listaOpcionesEncuesta">
    {opciones.map((opt, idx) => (
      <button
        type="button"
        class="geco-survey-btn"
        data-index={idx}
        data-opt-id={opt.id}
        aria-label={`Opción ${opt.titulo}`}
      >
        <!-- Barra de Progreso Dinámica -->
        <div class="geco-survey-progress" id={`surveyBar-${idx}`}></div>

        <!-- Contenido de la Opción -->
        <div class="geco-survey-btn-content">
          <div class="geco-survey-left">
            <div class="geco-survey-icon-circle">
              <i class:list={['fa-solid', opt.icono || 'fa-heart']}></i>
            </div>
            <div>
              <div class="geco-survey-text-title">{opt.titulo}</div>
              <div class="geco-survey-text-desc">{opt.descripcion}</div>
            </div>
          </div>
          <div class="geco-survey-pct" id={`surveyPct-${idx}`}>0%</div>
        </div>
      </button>
    ))}
  </div>

  <!-- Banner de Respuesta Personalizada -->
  <div class="geco-survey-feedback-banner" id="surveyFeedbackBanner">
    <i class="fa-solid fa-sparkles geco-heading-icon"></i>
    <span id="surveyFeedbackText"></span>
  </div>

  <!-- Pie de Encuesta: Total de Votos y Acciones Protegidas -->
  <div class="geco-survey-footer">
    <div class="geco-survey-total-label" id="surveyTotalLabel">
      <i class="fa-solid fa-chart-simple geco-heading-icon"></i>
      <span id="surveyTotalText">Cargando respuestas...</span>
    </div>

    <div class="geco-survey-actions">
      <!-- Botón de Actualizar con Enfriamiento para Cuidar Lecturas -->
      <button
        type="button"
        class="geco-survey-btn-refresh"
        id="btnActualizarVotos"
        title="Actualizar votos en tiempo real"
        aria-label="Actualizar resultados de la encuesta"
      >
        <i class="fa-solid fa-arrows-rotate" id="iconRefreshVotos"></i>
        <span>Actualizar</span>
      </button>

      <!-- Botón de Cambiar / Revertir Elección -->
      <button
        type="button"
        class="geco-survey-btn-reset"
        id="btnCambiarVoto"
        title="Cambiar mi elección"
        aria-label="Cambiar mi respuesta"
      >
        <i class="fa-solid fa-rotate-left"></i>
        <span>Cambiar respuesta</span>
      </button>
    </div>
  </div>
</div>
