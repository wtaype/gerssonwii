---
// src/core/componentes/Header.astro
// 👑 Cabecera Universal Agnóstica (Brand + Theme Switcher + User Pill)
// 100% Cero CSS Inline · Desacoplado de Semillas Específicas
import configurar from '@semillas/configurar.js';

const marca = configurar.marca || {};
const perfil = configurar.perfil || {};

const tituloHeader = marca.titulo || configurar.app || '';
const enlaceMarca = marca.enlace || '/';
const avatarSrc = perfil.avatar || perfil.avatarSm || '';
const avatarAlt = perfil.nombreCorto || perfil.nombre || '';
---

<header class="geco-header">
  <a href={enlaceMarca} class="geco-header-brand-link" title={tituloHeader}>
    <span class="geco-header-brand-title">{tituloHeader}</span>
  </a>

  <div class="geco-header-right">
    <button type="button" class="geco-theme-pill-btn" id="btnTemaHeader" title="Cambiar tema Luz/Noche" aria-label="Cambiar tema visual">
      <i class="fa-solid fa-sun" id="iconoTemaHeader"></i>
      <span id="textoTemaHeader">Luz</span>
    </button>

    {avatarSrc && (
      <a href={enlaceMarca} class="geco-header-avatar-link" title={avatarAlt}>
        <img src={avatarSrc} alt={avatarAlt} class="geco-avatar-header" />
      </a>
    )}
  </div>
</header>
