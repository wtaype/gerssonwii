    margin-bottom: 10px;
  }

  .geco-app-success-desc {
    font-size: 0.88rem;
    color: var(--tx2);
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .geco-app-btn-success-close {
    padding: 10px 24px;
    background: var(--mco);
    color: #ffffff;
    border: none;
    border-radius: var(--r_pill, 9999px);
    font-size: 0.88rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);
    transition: all var(--tr_f);
