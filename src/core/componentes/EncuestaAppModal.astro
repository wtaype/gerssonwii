  @keyframes gecoPulseStar {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  @keyframes gecoBounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-12px); }
    60% { transform: translateY(-6px); }
  }
</style>

<script>
  import {
    haCompletadoEncuestaApp,
    haDescartadoEncuestaApp,
    marcarDescartadaEncuestaApp,
    obtenerTiempoInicioSesion,
    obtenerFeedbackPuntaje,
    TIEMPO_ESPERA_MS
  } from '@feature/encuesta-app/data/cacheAppEncuesta.js';
  import { enviarFeedbackApp } from '@feature/encuesta-app/data/dataAppEncuesta.js';

  let puntajeSeleccionado: number | null = null;
  let temporizadorApp: any = null;

  function inicializarEncuestaApp() {
    // Si el usuario ya completó la encuesta previamente, nunca mostrar
    if (haCompletadoEncuestaApp()) {
      ocultarBannerYModal();
      return;
    }

    // Si el usuario la descartó en esta sesión, tampoco insistir
    if (haDescartadoEncuestaApp()) {
      ocultarBannerYModal();
      return;
    }

    // Calcular tiempo restante de los 60 segundos
    const inicio = obtenerTiempoInicioSesion();
    const transcurrido = Date.now() - inicio;
    const restante = Math.max(0, TIEMPO_ESPERA_MS - transcurrido);

    if (temporizadorApp) clearTimeout(temporizadorApp);

    if (restante <= 0) {
      mostrarBanner();
    } else {
      temporizadorApp = setTimeout(() => {
        if (!haCompletadoEncuestaApp() && !haDescartadoEncuestaApp()) {
          mostrarBanner();
        }
      }, restante);
    }
  }

  function mostrarBanner() {
    const banner = document.getElementById('gecoAppSurveyBanner');
    if (banner) {
      banner.hidden = false;
    }
  }

  function ocultarBannerYModal() {
    const banner = document.getElementById('gecoAppSurveyBanner');
    const modal = document.getElementById('gecoAppSurveyModal');
    if (banner) banner.hidden = true;
    if (modal) modal.hidden = true;
  }

  function abrirModal() {
    const modal = document.getElementById('gecoAppSurveyModal');
    const banner = document.getElementById('gecoAppSurveyBanner');
    if (modal) {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    // Al abrir el modal, ocultamos el banner
    if (banner) banner.hidden = true;
  }

  function cerrarModal() {
    const modal = document.getElementById('gecoAppSurveyModal');
    if (modal) {
      modal.hidden = true;
      document.body.style.overflow = '';
    }
    marcarDescartadaEncuestaApp();
  }

  function seleccionarPuntaje(score: number) {
    puntajeSeleccionado = score;
    const chips = document.querySelectorAll('.geco-app-chip');
    chips.forEach((c) => {
      const sc = Number(c.getAttribute('data-score'));
      if (sc === score) {
        c.classList.add('selected');
      } else {
        c.classList.remove('selected');
      }
    });

    // Actualizar pill de feedback dinámico
    const boxFeedback = document.getElementById('boxFeedbackPuntaje');
    const badge = document.getElementById('lblFeedbackBadge');
    const texto = document.getElementById('lblFeedbackTexto');
    const btnSubmit = document.getElementById('btnEnviarEncuestaApp') as HTMLButtonElement;

    const fb = obtenerFeedbackPuntaje(score);
    if (boxFeedback && badge && texto) {
      boxFeedback.hidden = false;
      badge.textContent = fb.badge;
      texto.textContent = fb.texto;
    }

    if (btnSubmit) {
      btnSubmit.disabled = false;
    }
  }

  async function manejarEnvio() {
    if (puntajeSeleccionado === null) return;

    const btnSubmit = document.getElementById('btnEnviarEncuestaApp') as HTMLButtonElement;
    const txtComentario = document.getElementById('txtComentarioApp') as HTMLTextAreaElement;
    const comentario = txtComentario ? txtComentario.value.trim() : '';

    if (btnSubmit) {
      btnSubmit.disabled = true;
      btnSubmit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
    }

    try {
      await enviarFeedbackApp({
        calificacion: puntajeSeleccionado,
        comentario
      });

      // Disparar confeti global de celebración
      if (typeof (window as any).lanzarConfeti === 'function') {
        (window as any).lanzarConfeti(90);
      }

      // Mostrar estado de éxito
      const formState = document.getElementById('seccionFormularioApp');
      const exitoState = document.getElementById('seccionExitoApp');
      if (formState) formState.hidden = true;
      if (exitoState) exitoState.hidden = false;

      // Auto-cerrar tras 3.5 segundos
      setTimeout(() => {
        cerrarModal();
      }, 3500);
    } catch (err) {
      console.warn('[Encuesta App] Error en envío:', err);
      cerrarModal();
    }
  }

  // Delegación de eventos global (resiste cambios de página de Astro ClientRouter)
  if (typeof window !== 'undefined' && !(window as any).__gecoEncuestaAppConfigurada) {
    (window as any).__gecoEncuestaAppConfigurada = true;

    document.addEventListener('click', (e: any) => {
      // 1. Abrir modal desde banner (botón o tarjeta)
      if (e.target.closest('#btnTriggerModalApp, #btnAbrirModalDesdeBanner')) {
        if (!e.target.closest('#btnCerrarBannerApp')) {
          e.preventDefault();
          abrirModal();
          return;
        }
      }

      // 2. Cerrar banner
      if (e.target.closest('#btnCerrarBannerApp')) {
        e.preventDefault();
        const banner = document.getElementById('gecoAppSurveyBanner');
        if (banner) banner.hidden = true;
        marcarDescartadaEncuestaApp();
        return;
      }

      // 3. Cerrar modal
      if (e.target.closest('#btnCerrarModalApp, #btnPosponerEncuestaApp, #btnCerrarExitoApp')) {
        e.preventDefault();
        cerrarModal();
        return;
      }

      // 4. Clic fuera del modal (backdrop)
      const modal = document.getElementById('gecoAppSurveyModal');
      if (modal && e.target === modal) {
        cerrarModal();
        return;
      }

      // 5. Clic en chips de puntaje
      const chip = e.target.closest('.geco-app-chip');
      if (chip) {
        e.preventDefault();
        const score = Number(chip.getAttribute('data-score'));
        if (!isNaN(score)) {
          seleccionarPuntaje(score);
        }
        return;
      }

      // 6. Botón enviar
      if (e.target.closest('#btnEnviarEncuestaApp')) {
        e.preventDefault();
        manejarEnvio();
        return;
      }
    });

    // Contador de caracteres
    document.addEventListener('input', (e: any) => {
      if (e.target && e.target.id === 'txtComentarioApp') {
        const lbl = document.getElementById('lblCharCount');
        if (lbl) lbl.textContent = String(e.target.value.length);
      }
    });
  }

  // Inicializar en carga de página
  inicializarEncuestaApp();
  document.addEventListener('astro:page-load', inicializarEncuestaApp);
</script>
