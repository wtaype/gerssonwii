---
// src/core/componentes/EncuestaAppModal.astro
// 🌟 Pop-up Inteligente y Sutil de Calificación de la App (/encuestas/app)
// Requerimiento: Aparece tras 1 min (60s) en el footer de forma sutil sin interrumpir la navegación
// Opciones: Calificación 0-10, Sugerencias de mejora opcionales, Agradecimiento cálido con Confeti
---

<!-- 1. Banner Flotante Sutil en Footer (Aparece automáticamente a los 60s) -->
<aside id="gecoAppSurveyBanner" class="geco-app-banner" aria-label="Encuesta de satisfacción de la web" hidden>
  <div class="geco-app-banner-card" id="btnTriggerModalApp">
    <div class="geco-app-banner-icon">
      <i class="fa-solid fa-star"></i>
    </div>
    <div class="geco-app-banner-info">
      <span class="geco-app-banner-title">¿Te gusta la web de Gersson? ⭐</span>
      <span class="geco-app-banner-sub">Tu opinión en menos de 1 minuto</span>
    </div>
    <button type="button" class="geco-app-banner-action" id="btnAbrirModalDesdeBanner">
      <span>Calificar</span>
      <i class="fa-solid fa-chevron-right"></i>
    </button>
    <button type="button" class="geco-app-banner-close" id="btnCerrarBannerApp" title="Cerrar por ahora" aria-label="Cerrar banner">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
</aside>

<!-- 2. Modal Interactivo de Calificación y Feedback -->
<div id="gecoAppSurveyModal" class="geco-app-modal-backdrop" hidden>
  <div class="geco-app-modal-card" role="dialog" aria-modal="true" aria-labelledby="tituloEncuestaApp">
    
    <!-- Encabezado con Badge y Botón Cerrar -->
    <div class="geco-app-modal-header">
      <div class="geco-app-modal-badge">
        <i class="fa-solid fa-sparkles"></i>
        <span>TU OPINIÓN SUMA</span>
      </div>
      <button type="button" class="geco-app-modal-close" id="btnCerrarModalApp" aria-label="Cerrar ventana">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Estado A: Formulario de Calificación -->
    <div id="seccionFormularioApp" class="geco-app-form-state">
      <h2 id="tituloEncuestaApp" class="geco-app-modal-title">
        ¡Gracias por visitar la web de Gersson! 🌟
      </h2>
      <p class="geco-app-modal-desc">
        Nos gustaría saber tu opinión sincera. Toma menos de 1 minuto:
      </p>

      <!-- Pregunta 1: Escala 0 a 10 -->
      <div class="geco-app-group">
        <label class="geco-app-label">
          <span class="geco-app-label-num">1</span>
          <span>De 0 a 10, ¿cuánto calificas esta experiencia web?</span>
        </label>
        
        <div class="geco-app-chips" role="radiogroup" aria-label="Calificación de 0 a 10">
          <button type="button" class="geco-app-chip" data-score="0">0</button>
          <button type="button" class="geco-app-chip" data-score="1">1</button>
          <button type="button" class="geco-app-chip" data-score="2">2</button>
          <button type="button" class="geco-app-chip" data-score="3">3</button>
          <button type="button" class="geco-app-chip" data-score="4">4</button>
          <button type="button" class="geco-app-chip" data-score="5">5</button>
          <button type="button" class="geco-app-chip" data-score="6">6</button>
          <button type="button" class="geco-app-chip" data-score="7">7</button>
          <button type="button" class="geco-app-chip" data-score="8">8</button>
          <button type="button" class="geco-app-chip" data-score="9">9</button>
          <button type="button" class="geco-app-chip" data-score="10">10</button>
        </div>

        <!-- Feedback dinámico por puntaje -->
        <div id="boxFeedbackPuntaje" class="geco-app-score-feedback" hidden>
          <span class="geco-app-feedback-badge" id="lblFeedbackBadge">¡Excelente!</span>
          <span class="geco-app-feedback-text" id="lblFeedbackTexto"></span>
        </div>
      </div>

      <!-- Pregunta 2: Comentario Abierto (Opcional) -->
      <div class="geco-app-group">
        <label for="txtComentarioApp" class="geco-app-label">
          <span class="geco-app-label-num">2</span>
          <span>¿Qué te gustó o qué nos ayudaría a mejorar?</span>
          <span class="geco-app-opcional">(Opcional)</span>
        </label>
        <textarea
          id="txtComentarioApp"
          class="geco-app-textarea"
          rows="3"
          maxlength="300"
          placeholder="Escribe tus palabras, sugerencias o felicitaciones aquí..."
        ></textarea>
        <div class="geco-app-counter">
          <span id="lblCharCount">0</span>/300 caracteres
        </div>
      </div>

      <!-- Botones de Acción -->
      <div class="geco-app-actions">
        <button type="button" id="btnEnviarEncuestaApp" class="geco-app-btn-submit" disabled>
          <i class="fa-solid fa-paper-plane"></i>
          <span>Enviar mi opinión 🚀</span>
        </button>
        <button type="button" id="btnPosponerEncuestaApp" class="geco-app-btn-cancel">
          Quizás luego
        </button>
      </div>
    </div>

    <!-- Estado B: Mensaje Cálido de Agradecimiento -->
    <div id="seccionExitoApp" class="geco-app-success-state" hidden>
      <div class="geco-app-success-icon">🥳✨</div>
      <h3 class="geco-app-success-title">¡Muchísimas gracias por tu tiempo y cariño! 🙏</h3>
      <p class="geco-app-success-desc">
        Tus respuestas nos inspiran y nos ayudan a que la gran noche de Gersson sea una experiencia inolvidable. ¡Que Dios te bendiga grandemente!
      </p>
      <button type="button" id="btnCerrarExitoApp" class="geco-app-btn-success-close">
        <span>¡Listo, gracias! ❤️</span>
      </button>
    </div>

  </div>
</div>

<style>
  /* 1. Banner Flotante en Footer */
  .geco-app-banner {
    position: fixed;
    z-index: 9998;
    bottom: calc(var(--nav_bottom_h, 72px) + 14px);
    left: 14px;
    right: 14px;
    max-width: 440px;
    margin: 0 auto;
    pointer-events: auto;
    animation: gecoSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (min-width: 901px) {
    .geco-app-banner {
      left: auto;
      right: 28px;
      bottom: 24px;
      margin: 0;
    }
  }

  .geco-app-banner-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--bg-card);
    border: 1px solid var(--border-accent);
    border-radius: var(--r_l, 1.2vh);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.16), 0 2px 8px rgba(217, 119, 6, 0.15);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: transform var(--tr_f), box-shadow var(--tr_f);
    cursor: pointer;
  }

  .geco-app-banner-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
  }

  .geco-app-banner-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.35);
    animation: gecoPulseStar 2.2s infinite ease-in-out;
  }

  .geco-app-banner-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .geco-app-banner-title {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--tx1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
