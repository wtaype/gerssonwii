  .geco-app-btn-success-close:hover {
    background: #b45309;
    transform: scale(1.04);
  }

  /* Animaciones */
  @keyframes gecoSlideUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes gecoFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes gecoScaleUp {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
