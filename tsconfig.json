{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@servicios/*": ["./src/core/servicios/*"],
      "@semillas/*": ["./src/semillas/*"],
      "@widev": ["./src/core/widev/widev.js"],
      "@widev/*": ["./src/core/widev/*"],
      "@wii": ["./src/wii.js"],
      "@feature/*": ["./src/feature/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
